[46.917514, "o", "\u001b[H\u001b[2J\u001b[3J"]
[46.917595, "o", "\u001b[1;36m== SHOT 2 - the approval envelope: who approved these bytes, and the HMAC over them\u001b[0m\r\n\r\n"]
[47.920935, "o", "\u001b[1;33m$ python3 show_envelope.py task_contract.json\u001b[0m\r\n"]
[47.946416, "o", "-- approval envelope (HMAC-SHA256 over the canonical plan bytes) --\r\n"]
[47.94642, "o", "{\r\n  \"approved_by\": \"pfactory\",\r\n  \"approval_timestamp\": \"2026-07-30T10:54:15.233109+00:00\",\r\n  \"plan_contract_version\": \"2\",\r\n  \"signature\": \"210ae5496820844a97123083f17889454244924621f108349c360622c4263a58\"\r\n}\r\n"]
[47.946435, "o", "\r\n-- provenance (which plan, which repo, which commit) --\r\n"]
