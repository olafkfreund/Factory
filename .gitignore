
# Backstage TechDocs build output + toolchain venv
/site/
.techdocs-venv/

# local pre-wipe data-dir snapshots (large tarballs; restore steps in docs/dev/benchmark-matrix-runbook.md)
backups/

# jscpd duplication report output (.github/workflows/jscpd.yml)
reports/jscpd/

# python bytecode caches
__pycache__/
*.pyc

# Local direnv env (may hold secrets) — never commit
.envrc

# Local agent/tool state, not project content. `.claude/settings.local.json`
# is per-machine tool permissions; it once landed on main via a `git add -A`
# that swept the working tree. Ignored so that cannot happen again.
.claude/settings.local.json
# graphify knowledge graph: share the built graph and report (owner request,
# 2026-11-19), never the extraction cache or per-machine interpreter/root paths.
!graphify-out/
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/manifest.json
!graphify-out/.graphify_labels.json
